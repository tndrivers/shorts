{
  "name": "shorts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "python3 scripts/prepare.py",
    "studio": "remotion studio",
    "render": "remotion render Short out/short.mp4",
    "check": "remotion render ShortClean out/clean.mp4 --scale=0.5 && python3 scripts/check_render.py out/clean.mp4",
    "typecheck": "tsc --noEmit",
    "rig": "remotion render RigCheck out/rigcheck.mp4",
    "rig-editor": "python3 scripts/rig_editor.py"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.2.8",
    "@remotion/captions": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/noise": "4.0.535",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "typescript": "5.9.2"
  }
}
